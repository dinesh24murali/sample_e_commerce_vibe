# -------------------------------------------------------------------
# Django Core
# -------------------------------------------------------------------

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Settings module to use: bookstore.settings.development | bookstore.settings.production
DJANGO_SETTINGS_MODULE=bookstore.settings.development

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------------------------------------------
# Database — PostgreSQL
# -------------------------------------------------------------------

DB_NAME=bookstore_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# -------------------------------------------------------------------
# CORS (production only — comma-separated origins)
# -------------------------------------------------------------------

# CORS_ALLOWED_ORIGINS=https://yourshop.com,https://admin.yourshop.com

# -------------------------------------------------------------------
# JWT Token Lifetimes
# -------------------------------------------------------------------

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -------------------------------------------------------------------
# Razorpay Payment Gateway
# -------------------------------------------------------------------

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# -------------------------------------------------------------------
# Production Security (only needed when DJANGO_SETTINGS_MODULE=production)
# -------------------------------------------------------------------

# SECURE_SSL_REDIRECT=True
